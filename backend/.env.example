# Server
HOST=127.0.0.1
PORT=3002
NODE_ENV=development
# Ubuntu 正式环境使用 systemd；macOS 兼容环境才显式使用 manual。
# AI_GEO_PROCESS_MANAGER=systemd

# Database
# Relative paths are resolved from the backend process working directory.
# Production database paths must be on persistent disk.
DB_STORAGE=database.sqlite
# Production Supabase/Postgres example:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Security
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
# Same-machine Next.js/Nginx proxy requests do not need an origin allowlist.
# Add exact origins only for split-domain or non-loopback proxy deployments.
ALLOWED_ORIGINS=
# Encrypts AI platform API keys stored in the database. Must decode to exactly 32 bytes.
CONFIG_ENCRYPTION_KEY=
# Optional exact host:port entries for private AI endpoints, comma separated.
# AI_PLATFORM_PRIVATE_HOST_ALLOWLIST=localhost:11434,10.0.0.8:443
# Internal-only SEO audit mode. Defaults to false.
# When true, every authenticated user may audit backend localhost and RFC1918 IPv4 literals.
# Public self-registration is disabled automatically; create internal accounts from user management.
# Keep false on public or untrusted deployments.
SEO_AUDIT_ALLOW_PRIVATE_TARGETS=false

# Default admin bootstrap
# 仅用于一次性本地初始化；生产环境禁止启动期 bootstrap。
DEFAULT_ADMIN_BOOTSTRAP_ENABLED=false
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=
DEMO_USER_ENABLED=false
DEMO_USER_PASSWORD=

# v5 结构化分析使用进程级共享并发与有界等待队列，避免多个入口叠加放大上游请求。
AI_ANALYSIS_CONCURRENCY=2
AI_ANALYSIS_QUEUE_LIMIT=100
# 排队超过该时限会返回可重试的 503；允许范围 1000–120000ms，超界回落到 120000ms。
AI_ANALYSIS_QUEUE_TIMEOUT_MS=2400000
# 仅在正式发布验收窗口使用；未设置时用户名默认为 admin，密码回退到已有
# DEFAULT_ADMIN_PASSWORD。不得在命令行、日志或证据文件中传递密码。
# GEO010_ACCEPTANCE_USERNAME=admin
# GEO010_ACCEPTANCE_PASSWORD=

# Membership defaults
DEFAULT_MEMBERSHIP_LEVEL=free
QUOTA_LOW_THRESHOLD=0.2

# 营销监控默认关闭。试点契约决定仅授权或白名单真实数据能力。
MARKETING_MONITORING_ENABLED=false
MARKETING_MONITORING_PILOT_MODE=false
MARKETING_MONITORING_ALLOWED_PROJECT_IDS=
BAIDU_MARKETING_APP_ID=
BAIDU_MARKETING_SECRET_KEY=
BAIDU_MARKETING_SCOPE=
BAIDU_MARKETING_REDIRECT_URI=
BAIDU_MARKETING_CONTRACT_VERSION=
BAIDU_MARKETING_HTTP_TIMEOUT_MS=10000

# 官网表单咨询（独立于百度营销/百度统计）
GATO_WEBSITE_FORM_ENABLED=false
GATO_WEBSITE_FORM_BASE_URL=https://gato.com.cn
GATO_WEBSITE_FORM_PROJECT_ID=
GATO_WEBSITE_FORM_USERNAME=
GATO_WEBSITE_FORM_PASSWORD=
GATO_WEBSITE_FORM_HTTP_TIMEOUT_MS=10000
GATO_WEBSITE_FORM_CACHE_TTL_MS=600000
GATO_WEBSITE_FORM_MAX_STALE_MS=86400000

# AI platform names, URLs, models and keys are added manually at /admin/settings.
# DeepSeek Web uses a dedicated headed Chrome profile and never accepts Cookie or auth headers.
# Production profile and evidence paths must be on persistent disk.
# Optional Chrome executable; supported local paths are auto-detected when omitted.
# DEEPSEEK_WEB_CHROME_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Defaults to backend/.runtime/deepseek-web/profile and must not be a daily Chrome profile.
# DEEPSEEK_WEB_PROFILE_DIR=.runtime/deepseek-web/profile
# Defaults to backend/.runtime/deepseek-web/evidence.
# DEEPSEEK_WEB_EVIDENCE_DIR=.runtime/deepseek-web/evidence
# Overall Web interaction timeout in seconds (30-600, default 180).
# DEEPSEEK_WEB_TIMEOUT_SECONDS=180
# Enable only when the browser process has OS/container-level outbound network isolation.
# SEO_RENDER_NETWORK_ISOLATED=true
# Optional Chrome/Chromium executable for full-site JavaScript render sampling.
# SEO_RENDER_BROWSER_EXECUTABLE=/usr/bin/google-chrome
# Optional outbound proxy
# HTTPS_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080
# PROXY_URL=http://proxy.example.com:8080
